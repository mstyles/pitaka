{
  "name": "pitaka",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock --port 1430",
    "dev:demo": "vite --mode demo --port 1431",
    "build:demo": "tsc && vite build --mode demo --base /pitaka/demo/ --outDir dist-demo",
    "build:site": "npm run build:demo && rm -rf site-build && mkdir -p site-build/fonts site-build/screenshots && cp -r site/. site-build/ && cp src/assets/fonts/*.woff2 site-build/fonts/ && cp docs/screenshots/* site-build/screenshots/ && cp -r dist-demo site-build/demo",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.1.0",
    "typescript": "~7.0.2",
    "vite": "^8.0.16",
    "vitest": "^5.0.1"
  }
}
